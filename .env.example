# 图片服务配置
# 腾讯云（MPS AI换装 / 混元生图 / 3D 共用同一组密钥）
# 需要OSS可读写权限
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_MPS_REGION=ap-guangzhou

# 图片服务配置
# 火山引擎（即梦 AI换装）
# 需要OSS可读权限
VOLCENGINE_ACCESS_KEY=your_access_key
VOLCENGINE_SECRET_KEY=your_secret_key
VOLCENGINE_REGION=cn-north-1

# 图片服务配置
# 阿里云百炼（qwen-image 系列）
# 需要OSS可读权限
ALIYUN_BAILIAN_API_KEY=your_api_key
ALIYUN_BAILIAN_REGION=cn-beijing
ALIYUN_BAILIAN_BASE_URL=

# 文件存储配置
# 上传素材存储本地后同步到OSS
# 生成的结果暂存在OSS最终存储到本地
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=10485760
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PUBLIC_URL=https://your_bucket_name.cos.ap-guangzhou.myqcloud.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=your_bucket_name
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_PUBLIC_URL=https://your_bucket_name.oss-cn-hangzhou.aliyuncs.com

# 应用
NEXT_PUBLIC_APP_URL=http://localhost:3000
