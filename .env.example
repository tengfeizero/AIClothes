# 图片服务配置
# 腾讯云（MPS AI换装 / 混元生图 / 混元生3D / COS 共用同一组密钥）
# 需要 MPS、混元生图、混元生3D 与 COS 的读写权限
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_MPS_REGION=ap-guangzhou

# 图片服务配置
# 火山引擎（即梦 Seedream 图生图 / SeedEdit 指令编辑）
# 需要即梦相关服务的调用权限
VOLCENGINE_ACCESS_KEY=your_access_key
VOLCENGINE_SECRET_KEY=your_secret_key
VOLCENGINE_REGION=cn-north-1

# 图片服务配置
# 阿里云百炼（qwen-image 系列：生图 / 复刻 / 局部重绘）
# 需要百炼图像生成权限
ALIYUN_BAILIAN_API_KEY=your_api_key
ALIYUN_BAILIAN_REGION=cn-beijing
ALIYUN_BAILIAN_BASE_URL=

# 文件存储配置
# 上传素材先存储本地，再同步到对象存储（提供公网 URL 给 AI 厂商）
# 生成的结果只存本地，不上传对象存储
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE=10485760
# 对象存储提供方：aliyun（阿里云 OSS）| tencent（腾讯云 COS），默认 tencent
# 在云厂商可以随时开启关闭 AccessKey，不使用时建议关闭
STORAGE_PROVIDER=tencent
# 腾讯云 COS（复用上方 TENCENT_SECRET_ID / TENCENT_SECRET_KEY）
TENCENT_COS_BUCKET=your_bucket_name
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PUBLIC_URL=https://your_bucket_name.cos.ap-guangzhou.myqcloud.com
# 阿里云 OSS（STORAGE_PROVIDER=aliyun 时使用）
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=your_bucket_name
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_PUBLIC_URL=https://your_bucket_name.oss-cn-hangzhou.aliyuncs.com

# 应用
NEXT_PUBLIC_APP_URL=http://localhost:3000
